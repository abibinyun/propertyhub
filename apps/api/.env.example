# Database (Docker compose: localhost:5435)
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/property?schema=public

# Server & Client URLs
PORT=3003
APP_URL=http://localhost:3003
FRONTEND_URL=http://localhost:3004
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your-secret-key-min-32-characters
JWT_EXPIRES_IN=7d
JWT_COOKIE_MAX_AGE_DAYS=7

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Provider (log | resend)
EMAIL_PROVIDER=log
RESEND_API_KEY=

# Payment Provider (log | midtrans)
PAYMENT_PROVIDER=log
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Security & Expiry
BCRYPT_ROUNDS=10
VERIFICATION_TOKEN_EXPIRY_HOURS=24
VERIFICATION_RESEND_COOLDOWN_MINUTES=5
RESET_TOKEN_EXPIRY_HOURS=1

# Limits
LEAD_DAILY_LIMIT=10
IMAGE_MAX_SIZE_MB=5

# Featured Pricing (IDR)
FEATURED_PRICE_BASIC=99000
FEATURED_PRICE_PREMIUM=299000
FEATURED_PRICE_ULTIMATE=599000
FEATURED_DURATION_BASIC_DAYS=7
FEATURED_DURATION_PREMIUM_DAYS=7
FEATURED_DURATION_ULTIMATE_DAYS=30
